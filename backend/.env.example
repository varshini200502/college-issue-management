# ==============================================================================
# FastAPI Backend Configuration Template (backend/.env)
# Rename to backend/.env for local development.
# On Render: Set these as Environment Variables in your Render Dashboard.
# ==============================================================================

# Application Environment & Server Port
ENVIRONMENT="development"
PORT=8000
PROJECT_NAME="Centralized College Issue and Ticket Management System"
API_V1_STR="/api"

# JWT Authentication Security (Required: Generate using `openssl rand -hex 32`)
SECRET_KEY="your-strong-random-secret-key-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: Render provides DATABASE_URL automatically when linking Render PostgreSQL
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/college_issue_db"

# Storage Settings
UPLOAD_DIR="./uploads"

# CORS Configuration
# Comma-separated list of allowed origins. Add your deployed Vercel domain here.
CORS_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:5174,http://localhost:5173"

# Seed Settings (false for production; true only for local testing)
SEED_SAMPLE_TICKETS="false"
