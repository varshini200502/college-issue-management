backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.db
*.sqlite
*.sqlite3
*.egg-info/
build/
