# ==============================================================================
# Centralized College Issue and Ticket Management System - Root Environment Template
# Copy this file to backend/.env (and frontend/.env) and populate with your values.
# NEVER commit real credentials, passwords, or production secrets to Git!
# ==============================================================================

# Application Metadata
ENVIRONMENT="production" # "development" | "production"
PORT=8000
PROJECT_NAME="Centralized College Issue and Ticket Management System"
API_V1_STR="/api"

# JWT Authentication Security (Generate a strong random secret: `openssl rand -hex 32`)
SECRET_KEY="your-strong-random-secret-key-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# On Render: Auto-injected from Render PostgreSQL connection string
DATABASE_URL="postgresql+psycopg2://username:password@hostname:5432/college_issue_db"

# Storage Settings
UPLOAD_DIR="./uploads"

# CORS Allowed Origins (Comma-separated origins that can access backend)
# Include your Vercel frontend domain in production
CORS_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:5174"

# Master Data & Ticket Seeding
# In production, set to false so extra mock tickets are NOT inserted
SEED_SAMPLE_TICKETS="false"
