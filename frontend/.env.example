# ==============================================================================
# React + Vite Frontend Configuration Template (frontend/.env)
# Rename to frontend/.env for local development or set in Vercel Project Settings.
# ==============================================================================

# Backend API Base URL (Point to your deployed Render FastAPI service)
# Example: https://college-issue-backend.onrender.com
# For local development with Vite dev server proxy, leave empty or use /api
VITE_API_BASE_URL="https://your-backend-app.onrender.com"

# Demo Account Visibility
# Set to 'false' in production. In development, setting to 'true' displays the demo credentials helper.
VITE_ENABLE_DEMO_ACCOUNTS="false"
